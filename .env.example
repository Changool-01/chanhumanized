# Copy to .env and fill in values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite = no Docker needed for first run. mysql = local docker-compose or PythonAnywhere.
DJANGO_DB=sqlite

MYSQL_DATABASE=chan_humanized
MYSQL_USER=chan
MYSQL_PASSWORD=chan
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Required for Humanize. Set a hard monthly cap in the OpenAI dashboard ($10–20 for demo).
OPENAI_API_KEY=
# gpt-4o-mini is the default cheap model. Switch to gpt-4o for stronger quality at ~15x cost.
OPENAI_MODEL=gpt-4o-mini
